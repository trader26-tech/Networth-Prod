{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/ranjeev/Documents/projects/Networth/.codex/hooks/track-edit.sh'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/ranjeev/Documents/projects/Networth/.codex/hooks/auto-commit-push.sh'",
            "statusMessage": "Auto-committing & pushing to main..."
          }
        ]
      }
    ]
  }
}
