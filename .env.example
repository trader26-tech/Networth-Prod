# ── Required for live NSE / NFO data via Kite Connect ─────────────────────
# Get these from https://developers.kite.trade/
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ── Persistent store (Supabase) — see SUPABASE.md for setup ───────────────
# When BOTH are set, covered-call positions live in Supabase Postgres
# (survives container redeploys). When unset, falls back to the local JSON
# file (api/cc_positions.json) — fine for local dev only.
SUPABASE_URL=
SUPABASE_KEY=
# Optional: prefer the service-role key from backend (full access). If
# SUPABASE_SERVICE_KEY is present, it's used in preference to SUPABASE_KEY.
SUPABASE_SERVICE_KEY=

# ── App sign-in: email OTP + trusted-device PIN ───────────────────────────
# AUTH_SECRET signs the access tokens. Leave blank and the app generates +
# persists a strong one on first boot. Set it explicitly in production to keep
# sessions valid across redeploys (run: python -c "import secrets;print(secrets.token_urlsafe(48))").
AUTH_SECRET=
# Resend API key (https://resend.com → API Keys) — sends the 6-digit codes.
# If blank, codes are printed to the server log (dev only).
RESEND_API_KEY=
OTP_FROM=onboarding@resend.dev
# Comma-separated allowlist of emails that may request a login code.
OTP_ALLOWLIST=you@example.com

# ── Optional: AI assistant (Ollama / OpenAI) ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Server config (Railway sets PORT automatically) ───────────────────────
PORT=8000
PYTHONUNBUFFERED=1
